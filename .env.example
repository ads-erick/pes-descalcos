NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (sobe e apaga as fotos das cartinhas). Nunca expor no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (Supabase > Connect > Connection String > URI)
# Use sempre a do pooler: a conexao direta e so IPv6 e a Vercel nao alcanca.
# Porta 6543 (modo transacao) e a recomendada pra serverless; 5432 (sessao) tambem serve.
# Caracteres especiais da senha precisam estar codificados (ex: @ -> %40)
DATABASE_URL=

# Senha para entrar como admin e o segredo que assina o cookie de sessão
# Gerar segredo: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Captcha do login (Cloudflare Turnstile). Vazias = captcha desligado.
# Chaves de teste que sempre passam: site 1x00000000000000000000AA,
# secreta 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
